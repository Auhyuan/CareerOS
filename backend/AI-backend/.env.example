# -----------------------
# FastAPI 服务配置
# -----------------------
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT=8090
LOG_LEVEL="INFO"

# -----------------------
# 业务编排层服务配置
# -----------------------
ORCHESTRATION_BASE_URL="http://127.0.0.1:8091"
ORCHESTRATION_TIMEOUT_SECONDS=30

# -----------------------
# PostgreSQL 数据库配置
# -----------------------
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_USER="remote_root"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DATABASE="career_ai"

# -----------------------
# 前程无忧浏览器爬虫配置
# -----------------------
QCWY_BROWSER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# -----------------------
# LangSmith 可观测配置
# -----------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY="your_langsmith_api_key"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT="career-ai"
# -----------------------
# 文件服务配置
# -----------------------
# 上传目录；每个 file_id 会创建独立目录，保存 original.xxx 与 content.md。
AI_BACKEND_UPLOAD_DIR="D:/study/get_job_data/backend/AI-backend/data/uploads"
# 单次上传文件数上限。
FILE_MAX_FILES_PER_UPLOAD=10
# 单个文件大小上限，单位 MB。
FILE_MAX_SINGLE_FILE_MB=50
# 单次请求所有文件总大小上限，单位 MB。
FILE_MAX_TOTAL_UPLOAD_MB=100
# 上传文件时的流式写入块大小，单位 KB。
FILE_UPLOAD_CHUNK_KB=8
# 未指定行范围时，read_uploaded_file 默认读取的行数。
FILE_DEFAULT_READ_LINE_COUNT=200
# read_uploaded_file 单次返回内容的最大字符数。
FILE_MAX_READ_RESPONSE_CHARS=24000
