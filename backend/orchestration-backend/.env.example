# -----------------------
# FastAPI 服务配置
# -----------------------
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT=8091

# -----------------------
# MCP 服务配置
# -----------------------
MCP_SERVICE_NAME="career-ai-orchestration-tools"
MCP_MOUNT_PATH="/mcp"
MCP_TRANSPORT_PATH="/"

# 仅独立启动 MCP 服务时生效
MCP_HOST="127.0.0.1"
MCP_PORT=8092

# -----------------------
# 能力层服务配置
# -----------------------
AI_BACKEND_BASE_URL="http://127.0.0.1:8090"
AI_BACKEND_TIMEOUT_SECONDS=180

# -----------------------
# PostgreSQL 数据库配置
# -----------------------
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_USER="remote_root"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DATABASE="career_ai"
