# -----------------------
# FastAPI 服务
# -----------------------
APP_NAME="Hai-agent"
APP_HOST="127.0.0.1"
APP_PORT=8093
APP_RELOAD=true
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# -----------------------
# PostgreSQL
# -----------------------
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_USER="remote_root"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DATABASE="career_ai"
POSTGRES_SCHEMA="hai_agent"
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# -----------------------
# JWT
# 生产和正式测试环境必须替换为至少 32 字节的随机值。
# 可使用: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_ISSUER="hai-agent"
JWT_AUDIENCE="hai-agent-web"
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# -----------------------
# 阶段 Agent 模板
# 未配置时仍可创建节点，但执行该阶段 Agent 前必须完成配置。
# -----------------------
PROJECT_PREPARATION_AGENT_ID=""
REQUIREMENT_CONFIRMATION_AGENT_ID=""
CREATIVE_DIRECTION_AGENT_ID=""
PROPOSAL_GENERATION_AGENT_ID=""
FEEDBACK_REVISION_AGENT_ID=""

# -----------------------
# MCP 工作流工具
# MCP_RUNTIME_CONTEXT_SECRET 需要与 AI-backend 保持一致，并使用独立随机密钥。
# -----------------------
MCP_SERVICE_NAME="hai-agent-workflow-tools"
MCP_MOUNT_PATH="/mcp"
MCP_TRANSPORT_PATH="/"
MCP_RUNTIME_CONTEXT_SECRET="replace-with-a-long-random-mcp-context-secret"
MCP_RUNTIME_CONTEXT_ALGORITHM="HS256"
MCP_RUNTIME_CONTEXT_ISSUER="ai-backend"
MCP_RUNTIME_CONTEXT_AUDIENCE="hai-agent-mcp"
